rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App owner record for single-tenant lock
    match /app/owner {
      allow read: if true;
      // Allow creation only if the document does not exist yet (first-time setup)
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/app/owner);
      // Allow updates or deletion only by the established owner
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // User private data (KV store, files metadata, collections)
    match /users/{userId}/{document=**} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
